# ==============================================================================
# RiskLens Platform - Environment Configuration Template
# Copy this file to .env and configure values for your deployment environment:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Operational Environment & Server Runtime
# ------------------------------------------------------------------------------
# Runtime environment: "production", "staging", or "development"
RISKLENS_ENV=production

# Server bind host and port
HOST=0.0.0.0
PORT=8000

# Gunicorn / Uvicorn worker process concurrency (Recommended: 2 to 4 workers)
WORKERS=2

# ------------------------------------------------------------------------------
# 2. Authentication, Authorization & Security Hardening
# ------------------------------------------------------------------------------
# Set to 'true' in enterprise production to strictly enforce Bearer auth on all administrative mutations
RISKLENS_REQUIRE_AUTH=true

# Set to 'false' in production so password recovery tokens are NOT leaked in API responses
RISKLENS_DEMO_MODE=false

# Set to 'false' in production to prevent auto-seeding known default passwords (RiskLens@2026)
RISKLENS_SEED_DEMO_USERS=false

# Comma-separated list of allowed origins for Cross-Origin Resource Sharing (CORS)
# Example: https://risklens.enterprise.bank.com,https://ciso-portal.corp.internal
CORS_ORIGINS=

# Enable built-in rate-limiting protection against brute-force and DoS
RATE_LIMIT_ENABLED=true

# ------------------------------------------------------------------------------
# 3. Enterprise PostgreSQL Relational Database Configuration
# ------------------------------------------------------------------------------
# Full PostgreSQL connection URI (preferred)
DATABASE_URL=postgresql://risklens:risklens_password@localhost:5432/risklens

# Discrete PostgreSQL connection parameters (fallback if DATABASE_URL is not set)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=risklens
POSTGRES_USER=risklens
POSTGRES_PASSWORD=risklens_password

# Persistent storage directory for uploaded dossiers and exported reports
RISKLENS_DATA_DIR=/app/data

# ------------------------------------------------------------------------------
# 4. Optional Generative AI Cloud Providers
# If omitted, RiskLens seamlessly runs on its zero-dependency local deterministic NLP engine
# ------------------------------------------------------------------------------
# Google Gemini API Key (e.g. for Gemini 1.5 Flash query synthesis)
GEMINI_API_KEY=

# OpenAI API Key (e.g. for GPT-4o-mini synthesis)
OPENAI_API_KEY=
